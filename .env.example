# ---- Server ----
PORT=3000
HOST=0.0.0.0

# Public base URL used to build returned app links. In production, point this at the
# *apps* host (ideally a separate origin from the upload site) e.g. https://apps.dfad.example.com
APPS_BASE_URL=http://localhost:3000

# How long a deployed app lives. Accepts fractional hours for testing (e.g. 0.001).
TTL_HOURS=24

# Max upload size in bytes (default 5 MB).
MAX_BYTES=5242880

# Secret used to salt hashed uploader IPs (abuse triage). Set to a long random string in prod.
IP_HASH_SALT=change-me

# ---- Rate limiting (uploads) ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=10 minutes

# ---- Storage driver: "local" (disk, no AWS) or "s3" ----
STORAGE_DRIVER=local

# Local driver: where files + metadata live on disk.
LOCAL_DATA_DIR=./.data

# ---- AWS (only used when STORAGE_DRIVER=s3) ----
AWS_REGION=us-east-1
S3_BUCKET=dfad-apps
DYNAMODB_TABLE=dfad-deployments
