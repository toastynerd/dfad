{
  "name": "dfad",
  "version": "0.1.0",
  "description": "Deploy-for-a-day: host throwaway single-page HTML apps for 24 hours.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/public dist/public",
    "start": "node dist/server.js",
    "dev": "node --import tsx --watch src/server.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.620.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/lib-dynamodb": "^3.620.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.1",
    "fastify": "^5.1.0",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
